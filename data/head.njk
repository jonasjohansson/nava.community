<!DOCTYPE html>
<html lang="en" prefix="og: http://ogp.me/ns#">
    <head>
        <title>{{ site.title }}</title>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width,user-scalable=no" />
        <link rel="preload" as="font" href="/fonts/TTFirsNeue-ExtraLight.woff2" type="font/woff2" crossorigin="anonymous" />
		{% set css %} 
			{% include "assets/css/style.css" %} 
			{% include "assets/css/home.css" %} 
			{% include "assets/css/page.css" %} 
		{% endset %}
		<style>{{ css | cssmin | safe }}</style>
        {% if theme %}
        <style>
            html {
                background-image: linear-gradient({{ theme.background_color }}); 
                color: {{ theme.text_color }};
            }
        </style>
        {% endif %}
		{% set js %} 
			{% include "assets/js/app.js" %}
		{% endset %}
		<script async defer> {{ js | jsmin | safe }}</script>
    </head>
    <body id="{{ tags }}">   
