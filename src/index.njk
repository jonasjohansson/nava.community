---
layout: layouts/default.njk
body_class: home
members: [
	{name: Jonas Johansson, url: https://jonasjohansson.se, avatar: jonas},
	{name: Rasmus Stride, url: http://www.stridestud.io/, avatar: rasmus},
	{name: Katrín Hauksdottir, url: https://www.katikati.me/},
	{name: Atlí Bollason, url: https://atlibollason.com/},
	{name: Owen Hindley, url: http://www.owenhindley.co.uk/}
	]

---

<section>
	<h1>Nordic<br />Audio<br />Visual<br />Artists.</h1>
</section>
<section>
	<nav>
	{% for page in collections.page %}
		<a style="display:block;" href="{{ page.url }}">{{ page.data.title }}</a>
	{% endfor %}
	</nav>
	<p>
		{{ site.description }}
	</p>
	<base href="/assets/media/">
	<nav>
	{% for member in members %}
		<a href="{{ member.url }}" target="_blank">{{ member.name }}{% if member.avatar %}<img class="avatar" src="avatar-{{ member.avatar }}.gif">{% endif %}</a>
	{% endfor %}
	</nav>
</section>
<section>
    <p>NAVA is made possible by the Nordic Culture Fund.</p>
    <a href="https://www.nordiskkulturfond.org/"><img src="logo-nordisk-kulturfond.png" height="30"/></a>
</section>